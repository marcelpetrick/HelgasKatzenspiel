{
  "name": "helgas-katzenspiel",
  "version": "0.15.7",
  "description": "Ein niedliches Katzenspiel für den Browser: Ein Mädchen streichelt und versorgt ganz viele Katzen.",
  "private": true,
  "type": "module",
  "author": "Marcel Petrick <mail@marcelpetrick.it>",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . && prettier --check . && stylelint \"src/**/*.css\" && markdownlint-cli2 \"**/*.md\"",
    "format": "prettier --write . && stylelint \"src/**/*.css\" --fix && markdownlint-cli2 --fix \"**/*.md\"",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "pipeline": "./localPipeline.sh",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "9.28.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "markdownlint-cli2": "0.23.3",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
